    "test:shell:browser": "node scripts/check-shell.mjs",
    "test:records": "node --experimental-strip-types packages/records/test/records.ts",
    "test:session-store": "node --experimental-strip-types packages/session/test/sqlite.ts",
    "test:session-ops": "node --experimental-strip-types packages/web/test/session-ops.ts",
    "test:memory": "node --experimental-strip-types plugins/memory/test/memory.ts",
    "test:workspace-execution": "node --experimental-strip-types apps/server/test/workspace.ts",
    "test:deepseek-discovery": "node --experimental-strip-types plugins/provider-deepseek/test/discovery.ts",
    "test:studio": "node --experimental-strip-types plugins/plugin-studio/test/studio.ts",
