    "test:ask": "node --experimental-strip-types plugins/tool-ask/test/failure.ts",
    "test:questions": "node --experimental-strip-types packages/questions/test/failure.ts",
    "test:catalog": "MENG_QUIET=1 node --experimental-strip-types packages/web/test/catalog.ts",
    "test:provider": "MENG_QUIET=1 node --experimental-strip-types plugins/provider-deepseek/test/config.ts",
    "test:schema-form": "node --experimental-strip-types apps/web/src/app/settings/schema-form.test.ts",
    "test:model": "node --experimental-strip-types apps/web/src/app/settings/model.test.ts",
    "test:workspace": "node --experimental-strip-types apps/web/src/app/settings/workspace.test.ts",
    "test:keys": "node --experimental-strip-types apps/web/src/app/settings/keys.test.ts",
    "test:routes": "MENG_QUIET=1 node --experimental-strip-types plugins/provider-openai/test/routes.ts",
    "test:directory": "MENG_QUIET=1 node --experimental-strip-types plugins/provider-openai/test/directory.ts",
