    "test:background-command:browser": "node scripts/check-background-command.mjs",
    "test:context:browser": "node scripts/check-context.mjs",
    "test:queue": "node --experimental-strip-types apps/web/src/app/queue.test.ts",
    "test:queue:browser": "node scripts/check-queue.mjs",
    "test:tool-failure": "node --experimental-strip-types packages/tools/test/failure.ts",
    "test:queue-styles:browser": "node scripts/check-queue-styles.mjs"
