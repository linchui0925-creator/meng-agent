{
  "name": "{{packageName}}",
  "version": "0.1.0",
  "type": "module",
  "description": {{descriptionJson}},
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "client", "meng.patch.yml", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": { "build": "tsc -p tsconfig.json && vite build" },
  "peerDependencies": { "@meng/core": ">=0.0.0" },
  "devDependencies": {
    "@meng/core": "0.0.0",
    "@meng/modules": "0.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "meng": {
    "plugin": { "apiVersion": 1, "id": "{{id}}", "patch": "./meng.patch.yml" },
    "client": {
      "platforms": ["web", "desktop", "mobile"],
      "immediately": false,
      "slots": ["settings.section"]
    }
  }
}
