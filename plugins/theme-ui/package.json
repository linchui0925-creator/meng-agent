{
  "name": "@meng/plugin-theme-ui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "侧栏主题导航和标题栏主题切换插件",
  "main": "./src/client-entry.tsx",
  "exports": {
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "client",
    "src",
    "meng.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "test": "node --experimental-strip-types test/theme-nav.ts && node --experimental-strip-types test/contract.ts"
  },
  "devDependencies": {
    "@meng/modules": "workspace:*",
    "@meng/ui": "workspace:*",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "meng": {
    "client": {
      "platforms": [
        "web",
        "desktop"
      ],
      "immediately": false,
      "slots": [
        "sidebar.utility",
        "topbar.actions"
      ]
    }
  }
}
