{
  "name": "@meng/plugin-subagent-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "进程内子智能体：独立会话、独立上下文、只回传最终报告",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "meng.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types test/subagent.ts"
  },
  "dependencies": {
    "@meng/core": "workspace:*",
    "@meng/loop": "workspace:*",
    "@meng/session": "workspace:*",
    "@meng/subagent": "workspace:*",
    "@meng/web": "workspace:*"
  },
  "meng": {
    "plugin": {
      "apiVersion": 1,
      "id": "subagent-local",
      "patch": "./meng.patch.yml"
    }
  }
}
